rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The one organiser. Change this email (and ORGANISER in app.js) to hand the app to someone else.
    function organiser() { return 'contactpavankumarmeduri@gmail.com'; }

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && email() == organiser(); }
    function cfgExists() { return exists(/databases/$(database)/documents/config/settings); }
    function cfg() { return get(/databases/$(database)/documents/config/settings).data; }
    function phase() { return cfgExists() ? cfg().phase : 'submit'; }
    // A timer field is "open" when it is absent, or when the deadline is still ahead.
    function before(field) { return !(field in cfg()) || cfg()[field] == null || request.time < cfg()[field]; }
    // Submissions: phase must be submit, and either the submission timer has not ended, or the grace period is running.
    function submissionsOpen() {
      return phase() == 'submit' && (before('submitEndsAt') || ('graceEndsAt' in cfg() && cfg().graceEndsAt != null && request.time < cfg().graceEndsAt));
    }
    function votingOpen() { return phase() == 'vote' && before('voteEndsAt'); }
    function validSite(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 60
          && d.url is string && d.url.size() <= 200 && d.url.matches('https?://[^ ]{3,}')
          && d.keys().hasOnly(['name', 'url', 'createdAt']);
    }

    // Settings: phase submit / vote / closed, plus the timers (timestamps or null).
    match /config/settings {
      allow read: if signedIn();
      allow create, update: if isAdmin()
          && request.resource.data.phase in ['submit', 'vote', 'closed']
          && request.resource.data.keys().hasOnly(['phase', 'title', 'updatedAt', 'submitEndsAt', 'graceEndsAt', 'voteEndsAt', 'submitMinutes', 'voteMinutes', 'revealed']);
      allow delete: if false;
    }

    // Each student owns exactly one site document, keyed by their uid.
    match /sites/{uid} {
      allow read: if isAdmin() || (signedIn() && (request.auth.uid == uid || phase() != 'submit'));
      allow create: if signedIn() && request.auth.uid == uid && submissionsOpen()
          && validSite(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && submissionsOpen()
          && validSite(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // One vote per person (doc id = voter uid). Entrants only, never for yourself, only while the vote timer runs.
    // The vote can be moved or withdrawn as often as the voter likes until the timer ends.
    function validVote(d) {
      return d.keys().hasOnly(['site', 'createdAt']) && d.site is string && d.site != request.auth.uid
          && exists(/databases/$(database)/documents/sites/$(d.site));
    }
    function canVote() {
      return signedIn() && votingOpen() && exists(/databases/$(database)/documents/sites/$(request.auth.uid));
    }
    match /votes/{uid} {
      allow read: if isAdmin() || (signedIn() && (request.auth.uid == uid || phase() == 'closed'));
      allow create: if canVote() && request.auth.uid == uid && validVote(request.resource.data);
      allow update: if canVote() && request.auth.uid == uid && validVote(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() || (canVote() && request.auth.uid == uid);
    }
  }
}
